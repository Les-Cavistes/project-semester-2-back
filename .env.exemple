# Database configuration
DATABASE_URL="postgres://username:password@localhost/dbname"
RATP_API_KEY="always_late"

# Server configuration
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000,https://your-production-domain.com
SERVER_HOST="127.0.0.1"
SERVER_PORT="8000"

# Logging configuration
# Available levels: error, warn, info, debug, trace
# Format: <crate_name>=<level>[,<crate_name>=<level>]
# Examples:
# - RUST_LOG=info                    # Show info level for all crates
# - RUST_LOG=back=debug              # Show debug level for our app, info for others
# - RUST_LOG=back=debug,tower_http=info  # Debug for our app, info for HTTP logs
RUST_LOG=back=info,tower_http=info

# API Authentication
CAVISTS_API_KEY="doNotShareNorUseThisInProduction"